
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR = 'Exercise-9/python-flask-app'
        VENV = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Exercise-9/python-flask-app') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv "$VENV"
                        "$VENV/bin/python" -m pip install --upgrade pip
                        "$VENV/bin/pip" install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise-9/python-flask-app') {
                    echo 'Running unit tests...'
                    sh '''
                        "$VENV/bin/python" -m unittest discover -s .
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise-9/python-flask-app') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$DEPLOY_DIR"
                        cp app.py requirements.txt "$DEPLOY_DIR/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise-9/python-flask-app') {
                    echo 'Starting Flask application...'
                    sh '''
                        nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                            > "$DEPLOY_DIR/app.log" 2>&1 &
                        echo $! > "$DEPLOY_DIR/app.pid"
                        sleep 3

                        if ! kill -0 "$(cat "$DEPLOY_DIR/app.pid")"; then
                            cat "$DEPLOY_DIR/app.log"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('Exercise-9/python-flask-app') {
                    echo 'Testing application...'
                    sh '''
                        "$VENV/bin/python" test_app.py
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}


